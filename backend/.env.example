MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=equi_metrics

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=changeme
JWT_EXPIRE_MINUTES=10080

# Leave RESEND_API_KEY blank locally to log reset links to the console instead of emailing them.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Equi-Metrics <onboarding@resend.dev>

FRONTEND_URL=http://localhost:5173
