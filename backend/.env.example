MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB_NAME=equi_metrics

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=changeme
JWT_EXPIRE_MINUTES=10080

# Leave RESEND_API_KEY blank locally to log reset links to the console instead of emailing them.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Equi-Metrics <onboarding@resend.dev>

FRONTEND_URL=http://localhost:5173

# Optional: also allow CORS from origins matching this regex, e.g. Vercel's
# per-branch/PR preview URLs, which don't match a single fixed FRONTEND_URL.
# Leave blank to only allow FRONTEND_URL + localhost (previous behavior).
# Example for a Vercel project named "equi-metrics":
#   FRONTEND_PREVIEW_ORIGIN_REGEX=^https://equi-metrics.*\.vercel\.app$
FRONTEND_PREVIEW_ORIGIN_REGEX=

# Stripe billing. Leave all blank to disable /billing/* endpoints (they'll
# 503 instead of erroring). Get these from the Stripe Dashboard (test mode
# to start): STRIPE_SECRET_KEY from Developers > API keys,
# STRIPE_DEFAULT_PRICE_ID from a Product's recurring Price, and
# STRIPE_WEBHOOK_SECRET from either `stripe listen` (local dev) or the
# webhook endpoint you register in the Dashboard (production).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_PRICE_ID=
# Optional: defaults to {FRONTEND_URL}/account?checkout=success|cancel.
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
